#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform P {
    uint C; uint H; uint W; uint inOff; uint outOff;
} p;

layout(set = 0, binding = 0) readonly restrict buffer In { float A[]; };
layout(set = 0, binding = 1) writeonly restrict buffer Out { float O[]; };

void main() {
    uint outW = p.W * 2u;
    uint outH = p.H * 2u;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= p.C * outH * outW) return;

    uint ox = idx % outW;
    uint tmp = idx / outW;
    uint oy = tmp % outH;
    uint c = tmp / outH;

    uint sx = ox / 2u;
    uint sy = oy / 2u;
    O[p.outOff + c * outH * outW + oy * outW + ox] = A[p.inOff + c * p.H * p.W + sy * p.W + sx];
}
