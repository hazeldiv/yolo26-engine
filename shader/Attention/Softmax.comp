#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform P {
    uint rows; uint cols; uint off;
} p;

layout(set = 0, binding = 0) buffer X { float Xb[]; };

shared float red[256];

void main() {
    uint r = gl_WorkGroupID.x;
    if (r >= p.rows) return;
    uint base = p.off + r * p.cols;
    uint lane = gl_LocalInvocationID.x;

    float mx = -1e30;
    for (uint c = lane; c < p.cols; c += 256u) {
        float v = Xb[base + c];
        if (v > mx) mx = v;
    }
    red[lane] = mx;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (lane < s) red[lane] = max(red[lane], red[lane + s]);
        barrier();
    }
    float gmax = red[0];

    float sum = 0.0;
    for (uint c = lane; c < p.cols; c += 256u) {
        float e = exp(Xb[base + c] - gmax);
        Xb[base + c] = e;
        sum += e;
    }
    red[lane] = sum;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (lane < s) red[lane] += red[lane + s];
        barrier();
    }
    float inv = 1.0 / red[0];
    for (uint c = lane; c < p.cols; c += 256u) {
        Xb[base + c] *= inv;
    }
}
