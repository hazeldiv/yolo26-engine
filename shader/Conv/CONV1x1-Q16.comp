#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform P {
    uint M; uint K; uint Npad; uint Cstride;
    uint Ntrue; uint colOff; uint Aoff; uint Astride; uint flags;
} p;

layout(set = 0, binding = 0) readonly restrict buffer MatrixA { float A[]; };
layout(set = 0, binding = 1) readonly restrict buffer MatrixB { uvec4 B[]; };
layout(set = 0, binding = 2) writeonly restrict buffer MatrixC { float C[]; };
layout(set = 0, binding = 3) readonly restrict buffer MatrixR { float R[]; };

shared float As[16][16];
shared float Bs[16][33];

void main() {
    uint lx = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    uint tid = ly * 16u + lx;
    uint m0 = gl_WorkGroupID.y * 16u;
    uint n0 = gl_WorkGroupID.x * 32u;

    float acc00 = 0.0;
    float acc01 = 0.0;
    float acc10 = 0.0;
    float acc11 = 0.0;

    uint numTiles = (p.K + 15u) / 16u;
    for (uint t = 0; t < numTiles; t++) {
        uint k0 = t * 16u;
        uint i0 = tid;
        uint i1 = tid + 128u;
        As[i0 / 16u][i0 % 16u] = (k0 + i0 / 16u < p.K && m0 + i0 % 16u < p.M)
            ? A[p.Aoff + (k0 + i0 / 16u) * p.Astride + m0 + i0 % 16u] : 0.0;
        As[i1 / 16u][i1 % 16u] = (k0 + i1 / 16u < p.K && m0 + i1 % 16u < p.M)
            ? A[p.Aoff + (k0 + i1 / 16u) * p.Astride + m0 + i1 % 16u] : 0.0;
        if (tid < 64u) {
            uint row = tid / 32u;
            uint c = tid % 32u;
            uvec4 raw = B[(k0 / 8u + row) * p.Npad + n0 + c];
            uint kk = k0 + row * 8u;
            if (kk + 0u < p.K) Bs[row * 8u + 0u][c] = float(unpackHalf2x16(raw.x).x);
            if (kk + 1u < p.K) Bs[row * 8u + 1u][c] = float(unpackHalf2x16(raw.x).y);
            if (kk + 2u < p.K) Bs[row * 8u + 2u][c] = float(unpackHalf2x16(raw.y).x);
            if (kk + 3u < p.K) Bs[row * 8u + 3u][c] = float(unpackHalf2x16(raw.y).y);
            if (kk + 4u < p.K) Bs[row * 8u + 4u][c] = float(unpackHalf2x16(raw.z).x);
            if (kk + 5u < p.K) Bs[row * 8u + 5u][c] = float(unpackHalf2x16(raw.z).y);
            if (kk + 6u < p.K) Bs[row * 8u + 6u][c] = float(unpackHalf2x16(raw.w).x);
            if (kk + 7u < p.K) Bs[row * 8u + 7u][c] = float(unpackHalf2x16(raw.w).y);
        }
        barrier();
        for (uint k = 0u; k < 16u; k++) {
            float a0 = As[k][ly];
            float a1 = As[k][ly + 8u];
            float b0 = Bs[k][lx * 2u];
            float b1 = Bs[k][lx * 2u + 1u];
            acc00 += a0 * b0;
            acc01 += a0 * b1;
            acc10 += a1 * b0;
            acc11 += a1 * b1;
        }
        barrier();
    }

    uint mA = m0 + ly;
    uint mB = m0 + ly + 8u;
    uint nBase = n0 + lx * 2u;
    uint crow = p.colOff + nBase;

    if (mA < p.M && nBase < p.Ntrue) {
        float v = acc00 + R[nBase];
        if ((p.flags & 1u) != 0u) v = v / (1.0 + exp(-v));
        C[crow * p.Cstride + mA] = v;
    }
    if (mA < p.M && nBase + 1u < p.Ntrue) {
        float v = acc01 + R[nBase + 1u];
        if ((p.flags & 1u) != 0u) v = v / (1.0 + exp(-v));
        C[(crow + 1u) * p.Cstride + mA] = v;
    }
    if (mB < p.M && nBase < p.Ntrue) {
        float v = acc10 + R[nBase];
        if ((p.flags & 1u) != 0u) v = v / (1.0 + exp(-v));
        C[crow * p.Cstride + mB] = v;
    }
    if (mB < p.M && nBase + 1u < p.Ntrue) {
        float v = acc11 + R[nBase + 1u];
        if ((p.flags & 1u) != 0u) v = v / (1.0 + exp(-v));
        C[(crow + 1u) * p.Cstride + mB] = v;
    }
}
