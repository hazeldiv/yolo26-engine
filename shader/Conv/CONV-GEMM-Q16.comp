#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#define TS 16
#define TN 32
#define vec 4

layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform P {
    uint M; uint K; uint Npad; uint Cstride;
    uint Ntrue; uint colOff; uint Aoff; uint Astride; uint flags;
} p;

layout(set = 0, binding = 0) readonly restrict buffer MatrixA { vec4 A[]; };
layout(set = 0, binding = 1) readonly restrict buffer MatrixB { uvec4 B[]; };
layout(set = 0, binding = 2) writeonly restrict buffer MatrixC { float C[]; };
layout(set = 0, binding = 3) readonly restrict buffer MatrixR { float R[]; };

shared vec4 Asub[2][4][TS];
shared vec4 Bsub[2][4][TN];

void loadTiles(uint t, uint buf, uint tid) {
    if (tid < 64) {
        uint m = tid / 4;
        uint kv = tid % 4;
        Asub[buf][kv][m] = A[(gl_WorkGroupID.y * TS + m) * (p.Astride / vec) + p.Aoff / vec + t * 4 + kv];
    } else {
        uint lt = tid - 64u;
        uint block = lt / 32u;
        uint c = lt % 32u;
        uvec4 raw = B[(t * 2 + block) * p.Npad + gl_WorkGroupID.x * TN + c];
        Bsub[buf][block * 2][c]     = vec4(unpackHalf2x16(raw.x), unpackHalf2x16(raw.y));
        Bsub[buf][block * 2 + 1][c] = vec4(unpackHalf2x16(raw.z), unpackHalf2x16(raw.w));
    }
}

void main() {
    uint lx = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    uint tid = ly * 16u + lx;
    uint m0 = gl_WorkGroupID.y * TS;
    uint nBase = gl_WorkGroupID.x * TN;

    float acc00 = 0.0;
    float acc01 = 0.0;
    float acc10 = 0.0;
    float acc11 = 0.0;

    uint numTiles = p.K / TS;
    loadTiles(0, 0u, tid);
    barrier();
    for (uint t = 0; t < numTiles; t++) {
        uint cur = t & 1u;
        if (t + 1 < numTiles) loadTiles(t + 1, cur ^ 1u, tid);
        #pragma unroll
        for (uint kv = 0; kv < 4; kv++) {
            vec4 a0 = Asub[cur][kv][ly];
            vec4 a1 = Asub[cur][kv][ly + 8u];
            vec4 b0 = Bsub[cur][kv][lx * 2u];
            vec4 b1 = Bsub[cur][kv][lx * 2u + 1u];
            acc00 += dot(a0, b0);
            acc01 += dot(a0, b1);
            acc10 += dot(a1, b0);
            acc11 += dot(a1, b1);
        }
        barrier();
    }

    uint mA = m0 + ly;
    uint mB = m0 + ly + 8u;
    uint n0 = nBase + lx * 2u;
    uint crow = p.colOff + n0;

    if (n0 < p.Ntrue) {
        float v = acc00 + R[n0];
        if ((p.flags & 1u) != 0u) v = v / (1.0 + exp(-v));
        C[crow * p.Cstride + mA] = v;
    }
    if (n0 + 1u < p.Ntrue) {
        float v = acc01 + R[n0 + 1u];
        if ((p.flags & 1u) != 0u) v = v / (1.0 + exp(-v));
        C[(crow + 1u) * p.Cstride + mA] = v;
    }
    if (n0 < p.Ntrue) {
        float v = acc10 + R[n0];
        if ((p.flags & 1u) != 0u) v = v / (1.0 + exp(-v));
        C[crow * p.Cstride + mB] = v;
    }
    if (n0 + 1u < p.Ntrue) {
        float v = acc11 + R[n0 + 1u];
        if ((p.flags & 1u) != 0u) v = v / (1.0 + exp(-v));
        C[(crow + 1u) * p.Cstride + mB] = v;
    }
}
